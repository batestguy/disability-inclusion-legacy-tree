{
  "name": "isa-legacy",
  "private": true,
  "workspaces": [
    "apps/web",
    "studio"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "studio": "npm run dev -w studio",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "node --test scripts/content.test.mjs scripts/contribution-metrics.test.mjs scripts/chat-engine.test.mjs scripts/chat-preview.test.mjs scripts/guided-flow.test.mjs scripts/guided-presentation.test.mjs scripts/dashboard-data.test.mjs scripts/dashboard-presentation.test.mjs",
    "test:chat-browser": "node scripts/guided-browser-check.mjs",
    "metrics": "node scripts/export-contributions.mjs",
    "build": "npm run build -w apps/web && npm run build -w studio",
    "preflight": "node scripts/preflight.mjs",
    "test:browser": "node scripts/dashboard-presentation-browser-check.mjs",
    "test:dashboard-browser": "node scripts/dashboard-presentation-browser-check.mjs",
    "preview": "node scripts/serve.mjs",
    "test:performance": "node scripts/performance.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@playwright/test": "^1.56.0",
    "@axe-core/playwright": "^4.10.2",
    "lighthouse": "^13.0.0",
    "groq-js": "^1.23.0"
  }
}
